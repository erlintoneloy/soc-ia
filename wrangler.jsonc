{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soc-ia",
  "main": "worker/src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "frontend",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soc-ia-db",
      "database_id": "fca69b52-699c-4a57-a116-1039e548af16"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
