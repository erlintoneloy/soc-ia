{
  "name": "soc-ia",
  "version": "1.0.0",
  "private": true,
  "description": "SOC-IA: dashboard de agentes de seguridad sobre Cloudflare Workers, D1 y Workers AI",
  "type": "commonjs",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "sim": "node --env-file-if-exists=tests/.env tests/simulator.js",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/",
    "test:smoke": "node --env-file-if-exists=tests/.env --test tests/smoke.test.js",
    "db:reset": "node -e \"require('node:fs').rmSync('.wrangler/state', { recursive: true, force: true })\"",
    "db:init": "wrangler d1 execute soc-ia-db --local --file=worker/schema.sql && wrangler d1 execute soc-ia-db --local --file=worker/seed.sql",
    "db:init:remote": "wrangler d1 execute soc-ia-db --remote --yes --file=worker/schema.sql && wrangler d1 execute soc-ia-db --remote --yes --file=worker/seed.sql",
    "db:migrate": "wrangler d1 execute soc-ia-db --local --file=worker/migrations/0002-fase2.sql",
    "db:migrate:remote": "wrangler d1 execute soc-ia-db --remote --yes --file=worker/migrations/0002-fase2.sql",
    "db:migrate:activos": "wrangler d1 execute soc-ia-db --local --file=worker/migrations/0003-activos.sql",
    "db:migrate:activos:remote": "wrangler d1 execute soc-ia-db --remote --yes --file=worker/migrations/0003-activos.sql",
    "db:migrate:usuarios": "wrangler d1 execute soc-ia-db --local --file=worker/migrations/0004-usuarios-negocio.sql",
    "db:migrate:usuarios:remote": "wrangler d1 execute soc-ia-db --remote --yes --file=worker/migrations/0004-usuarios-negocio.sql",
    "db:migrate:logs": "wrangler d1 execute soc-ia-db --local --file=worker/migrations/0005-logs.sql",
    "db:migrate:logs:remote": "wrangler d1 execute soc-ia-db --remote --yes --file=worker/migrations/0005-logs.sql"
  },
  "devDependencies": {
    "wrangler": "^4.166.0"
  }
}
